From: Sakura286 <sakura286@outlook.com>
Subject: [PATCH] Retain the RISC-V glibc dynamic-address adjustment

Retain only the ELF dynamic-address adjustment from distribution commit
c6cb546ead2e4eb363330b49c698a194f0eceefd. Portable pause/fence helpers now
come from upstream ROCm PR #11310 instead of the old locks.h override.

diff --git a/runtime/hsa-runtime/core/util/lnx/os_linux.cpp b/runtime/hsa-runtime/core/util/lnx/os_linux.cpp
index c6d90f7..ceadc51 100644
--- a/runtime/hsa-runtime/core/util/lnx/os_linux.cpp
+++ b/runtime/hsa-runtime/core/util/lnx/os_linux.cpp
@@ -66,8 +66,12 @@
 #endif
 
 #ifdef __GLIBC__
-#define ABS_ADDR(base, ptr) (ptr)
+#if (defined(__riscv) && __riscv_xlen == 64)
+#define ABS_ADDR(base, ptr) ((base) + (ptr))
 #else
+#define ABS_ADDR(base, ptr) (ptr)
+#endif
+#else // Not __GLIBC__
 #define ABS_ADDR(base, ptr) ((base) + (ptr))
 #endif
 
