From: CHEN Xuan <chenxuan@iscas.ac.cn>
Subject: [PATCH] Preserve RISC-V stack pointer access

Rebased existing distribution adaptation onto ROCm therock-10.1.

--- a/rocclr/os/os_posix.cpp
+++ b/rocclr/os/os_posix.cpp
@@ -789,6 +789,9 @@
 #elif defined(ATI_ARCH_ARM)
       "mov %0,sp"
       : "=r"(value)
+#elif defined(ATI_ARCH_RISCV)
+      "mv %0,sp"
+      : "=r"(value)
 #else
       ""
 #endif
