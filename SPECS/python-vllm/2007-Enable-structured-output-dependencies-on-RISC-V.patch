From dfc6b6a4c4b7c488d388a8a9d8b21262fe0bc06c Mon Sep 17 00:00:00 2001
From: CHEN Xuan <chenxuan@iscas.ac.cn>
Date: Mon, 24 Aug 2026 10:54:42 +0800
Subject: [PATCH] Enable structured output dependencies on RISC-V

Upstream: not submitted

openRuyi packages llguidance and xgrammar for riscv64. Include that
architecture in the dependency markers so Python RPM dependency generation
records both runtime requirements.
---
 requirements/common.txt | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/requirements/common.txt b/requirements/common.txt
index 69fdf5c..37177b6 100644
--- a/requirements/common.txt
+++ b/requirements/common.txt
@@ -21,9 +21,9 @@ pillow  # Required for image processing
 prometheus-fastapi-instrumentator >= 7.1.0 # v8 unblocks starlette >= 1.0
 tiktoken >= 0.6.0  # Required for DBRX tokenizer
 lm-format-enforcer == 0.11.3
-llguidance >= 1.7.0, < 1.8.0; platform_machine == "x86_64" or platform_machine == "arm64" or platform_machine == "aarch64" or platform_machine == "ppc64le" or platform_machine == "s390x"
+llguidance >= 1.7.0, < 1.8.0; platform_machine == "x86_64" or platform_machine == "arm64" or platform_machine == "aarch64" or platform_machine == "ppc64le" or platform_machine == "s390x" or platform_machine == "riscv64"
 lark
-xgrammar >= 0.2.1, < 1.0.0; platform_machine == "x86_64" or platform_machine == "aarch64" or platform_machine == "arm64" or platform_machine == "s390x" or platform_machine == "ppc64le"
+xgrammar >= 0.2.1, < 1.0.0; platform_machine == "x86_64" or platform_machine == "aarch64" or platform_machine == "arm64" or platform_machine == "s390x" or platform_machine == "ppc64le" or platform_machine == "riscv64"
 typing_extensions >= 4.10
 filelock >= 3.16.1 # need to contain https://github.com/tox-dev/filelock/pull/317
 partial-json-parser # used for parsing partial JSON outputs
-- 
2.53.0

