[CPU][RISC-V] Fix build: make FP32Vec copy constructors non-explicit

cpu_attn_vec.hpp copy-initialises the halves of the pair returned by
load_b_pair_vec (`auto v = pair.first`). Copy-initialisation only considers
non-explicit constructors, and the RISC-V backend declares the FP32Vec8 and
FP32Vec16 copy constructors explicit, so the riscv64 build fails with
"no matching function for call to FP32Vec16::FP32Vec16(FP32Vec16&)".
Every other CPU backend leaves the copy constructor implicit; drop the
explicit from these two. The RISC-V CPU backend has not compiled since
upstream #49021.

Upstream: https://github.com/vllm-project/vllm/pull/51099
Upstream commit: ac7509e2b1db40fec2f03dde1ed4e9dfdc2338c9

diff --git a/csrc/cpu/cpu_types_riscv_impl.hpp b/csrc/cpu/cpu_types_riscv_impl.hpp
index 106bf44a2411..9a14d1c33866 100644
--- a/csrc/cpu/cpu_types_riscv_impl.hpp
+++ b/csrc/cpu/cpu_types_riscv_impl.hpp
@@ -427,7 +427,10 @@ struct FP32Vec8 : public Vec<FP32Vec8> {
   explicit FP32Vec8(const float* ptr)
       : reg(RVVI(__riscv_vle32_v_f32, LMUL_256)(ptr, VEC_ELEM_NUM)) {};
   explicit FP32Vec8(fixed_fp32x8_t data) : reg(data) {};
-  explicit FP32Vec8(const FP32Vec8& data) : reg(data.reg) {};
+  // Not explicit: copy-initialisation (`auto v = pair.first`) in
+  // cpu_attn_vec.hpp requires a converting copy constructor, and every other
+  // CPU backend leaves this implicit.
+  FP32Vec8(const FP32Vec8& data) : reg(data.reg) {};
   explicit FP32Vec8(const FP16Vec8& v)
       : reg(RVVI(__riscv_vfwcvt_f_f_v_f32, LMUL_256)(v.reg, VEC_ELEM_NUM)) {};
   explicit FP32Vec8(fixed_fp16x8_t v)
@@ -628,7 +631,8 @@ struct FP32Vec16 : public Vec<FP32Vec16> {
   explicit FP32Vec16(const FP32Vec8& data)
       : reg(RVVI4(__riscv_vcreate_v_f32, LMUL_256, _f32, LMUL_512)(
             data.reg, data.reg)) {};
-  explicit FP32Vec16(const FP32Vec16& data) : reg(data.reg) {};
+  // Not explicit: see FP32Vec8's copy constructor.
+  FP32Vec16(const FP32Vec16& data) : reg(data.reg) {};
   explicit FP32Vec16(int64_t value, const FP32Vec16& lut) {
     // Split into two 32-bit halves to avoid u64 @ LMUL_1024 (m8 on
     // VLEN=128 / m4 on VLEN=256), which causes heavy register spilling.
