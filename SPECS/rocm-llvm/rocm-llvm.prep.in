# Use the versioned system compiler, while retaining HIP_CLANG_PATH overrides.
LLVM_BINDIR=`%{bundle_prefix}/bin/llvm-config --bindir`
if [ ! -x "${LLVM_BINDIR}/clang++" ]; then
    echo "Something wrong with llvm-config"
    exit 1
fi

# Fail if upstream changes a path anchor instead of silently retaining a
# bundled-toolchain path. Explicit HIP_CLANG_PATH overrides remain supported.
python3 - "$LLVM_BINDIR" <<'PY'
from pathlib import Path
import sys

def replace_once(name, old, new):
    path = Path(name)
    text = path.read_text()
    if text.count(old) != 1:
        raise SystemExit(f"Expected one path anchor in {name}: {old}")
    path.write_text(text.replace(old, new))

replace_once('amd/hipcc/src/hipBin_amd.h',
             'hipClangPath /= "lib";\n    hipClangPath /= "llvm";\n    hipClangPath /= "bin";',
             f'hipClangPath = "{sys.argv[1]}";')
replace_once('amd/hipcc/src/hipBin_amd.h',
             'amdgcnBitcode = roccmPath',
             'amdgcnBitcode = "%{amd_device_libs_prefix}/"')
# CMP0053 OLD is only needed on Windows and was removed in CMake 4.
replace_once('amd/device-libs/cmake/OCL.cmake',
             'cmake_policy(SET CMP0053 OLD)',
             'cmake_policy(SET CMP0053 NEW)')
PY
