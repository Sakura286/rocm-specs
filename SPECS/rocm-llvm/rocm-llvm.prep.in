# Use the versioned system compiler, while retaining HIP_CLANG_PATH overrides.
LLVM_BINDIR=`%{bundle_prefix}/bin/llvm-config --bindir`
if [ ! -x "${LLVM_BINDIR}/clang++" ]; then
    echo "Something wrong with llvm-config"
    exit 1
fi
sed -i "s@hipClangPath /= \"lib/llvm/bin\"@hipClangPath = \"${LLVM_BINDIR}\"@" amd/hipcc/src/hipBin_amd.h

# The packaged device libraries live in the system Clang resource directory.
sed -i 's@amdgcnBitcode = roccmPath@amdgcnBitcode = "%{amd_device_libs_prefix}/"@' amd/hipcc/src/hipBin_amd.h
sed -i 's|@AMD_DEVICE_LIBS_PREFIX_CODE@|set(AMD_DEVICE_LIBS_PREFIX "%{amd_device_libs_prefix}")|' amd/device-libs/AMDDeviceLibsConfig.cmake.in

# CMP0053 OLD is only needed on Windows and was removed in CMake 4.
sed -i 's/cmake_policy(SET CMP0053 OLD)/cmake_policy(SET CMP0053 NEW)/' amd/device-libs/cmake/OCL.cmake
