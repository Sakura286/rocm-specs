 // RUN: %llvm-readelf --notes %t.output.elf | %FileCheck --check-prefix=OUTPUT-META %s
-// OUTPUT-META: amdhsa.target: amdgcn-amd-amdhsa{{--|-unknown-}}gfx1250
+// OUTPUT-META: amdhsa.target: amd{{gcn|gpu[0-9.]+}}-amd-amdhsa{{--|-unknown-}}gfx1250
 
