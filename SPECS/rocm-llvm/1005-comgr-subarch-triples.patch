-// INPUT-META: amdhsa.target: amdgcn-amd-amdhsa{{--|-unknown-}}gfx1250
+// INPUT-META: amdhsa.target: amd{{gcn|gpu[0-9.]+}}-amd-amdhsa{{--|-unknown-}}gfx1250
 
