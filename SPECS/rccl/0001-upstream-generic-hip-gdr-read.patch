From 6305765daacadbbef27e921c1907f13674e71fbd Mon Sep 17 00:00:00 2001
From: Ben Richard <143630488+benrichard-amd@users.noreply.github.com>
Subject: [PATCH] fix(rccl) implement generic code path in HIP/AMD GDR wrapper

Upstream: https://github.com/ROCm/rocm-systems/commit/6305765daacadbbef27e921c1907f13674e71fbd
Backport: strip projects/rccl/ for the standalone 10.1 asset; no prerequisite
commits or semantic changes. GPU DMA ordering on RISC-V remains unverified.

diff --git a/src/transport/coll_net.cc b/src/transport/coll_net.cc
--- a/src/transport/coll_net.cc
+++ b/src/transport/coll_net.cc
@@ -1278,10 +1278,9 @@ static ncclResult_t recvProxyProgress(struct ncclProxyState* proxyState, struct
               asm volatile("mov (%0), %%eax" ::"l"(resources->gdcFlush) : "%eax", "memory");
 #else
               // Portable equivalent. seq_cst fence keeps the load inside
-              // ncclGdrCudaRead from being reordered ahead of the CQE poll.
+              // the volatile read from being reordered ahead of the CQE poll.
               std::atomic_thread_fence(std::memory_order_seq_cst);
-              uint64_t dummy;
-              NCCLCHECK(ncclGdrCudaRead(resources->gdrDesc, &dummy, resources->gdcFlush, sizeof(dummy)));
+              (void)*(volatile uint64_t*)resources->gdcFlush;
 #endif
             } else {
               NCCLCHECK(collNetRecvFlush(proxyState, resources, args, sub, groupStart, totalSize, recvBeg,
