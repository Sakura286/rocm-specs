Disable PyTorch's ROCm aotriton ExternalProject hook.  The openRuyi build sets
USE_FLASH_ATTENTION=OFF and USE_MEM_EFF_ATTENTION=OFF, and distro builds must
not download aotriton runtime/source artifacts from CMake.

Inspired by Debian's rocm-disable-aotriton-download.patch.

diff --git a/CMakeLists.txt b/CMakeLists.txt
index a8b655d9c..beac8b93d 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -984,12 +984,6 @@ cmake_dependent_option(
 # Cannot be put into Dependencies.cmake due circular dependency:
 # USE_FLASH_ATTENTION -> USE_ROCM -> Dependencies.cmake -> aotriton.cmake
 #
-if(USE_ROCM)
-  if(USE_FLASH_ATTENTION OR USE_MEM_EFF_ATTENTION)
-    include(cmake/External/aotriton.cmake)
-  endif()
-endif()
-
 if(DEBUG_CUDA)
   string(APPEND CMAKE_CUDA_FLAGS_DEBUG " -lineinfo")
   string(APPEND CMAKE_CUDA_FLAGS_RELWITHDEBINFO " -lineinfo")
