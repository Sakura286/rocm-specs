Append the openRuyi ROCm HIP device compiler flags to PyTorch 2.13's
CMAKE_HIP_FLAGS.  Upstream already enables --offload-compress; openRuyi also
needs bounded offload parallelism, the AMDGPU long-branch workaround for large
generated kernels, and a small set of clang warning suppressions.

diff --git a/cmake/Dependencies.cmake b/cmake/Dependencies.cmake
index 2baa187e6..3d0db0cfc 100644
--- a/cmake/Dependencies.cmake
+++ b/cmake/Dependencies.cmake
@@ -1052,7 +1052,7 @@ if(USE_ROCM)
     endif()
     # CMAKE_HIP_FLAGS: flags passed to the HIP compiler for device code.
     # Architecture is handled by CMAKE_HIP_ARCHITECTURES (set in LoadHIP.cmake).
-    string(APPEND CMAKE_HIP_FLAGS " --offload-compress -std=c++20")
+    string(APPEND CMAKE_HIP_FLAGS " --offload-compress --offload-jobs=8 -mllvm --amdgpu-long-branch-factor=2 -mllvm --amdgpu-s-branch-bits=15 -Wno-deprecated-declarations -Wno-unused-result -Wno-unused-command-line-argument -Wno-pass-failed -std=c++20")
     # Pass device library path for theRock nightly builds
     if(DEFINED ENV{HIP_DEVICE_LIB_PATH})
       file(TO_CMAKE_PATH "$ENV{HIP_DEVICE_LIB_PATH}" _hip_device_lib_path)
