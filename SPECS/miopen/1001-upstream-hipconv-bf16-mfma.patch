From: amd-alavin <andrew.lavin@amd.com>
Subject: [PATCH] MIOpen: backport hipconv BF16 MFMA operand conversion

Upstream: https://github.com/ROCm/rocm-libraries/commit/d7b6c31cb268642a7b8f97cc202fa418ea3d4190
Upstream-PR: https://github.com/ROCm/rocm-libraries/pull/13016 (merged)
Upstream-Commit: d7b6c31cb268642a7b8f97cc202fa418ea3d4190

Backport only the self-contained mfma_dispatch.h compatibility fix from the
hipconv v0.3.2 sync. The remaining kernel additions and solver changes are
not required. Keep all upstream hunks for this file and strip the monorepo
projects/miopen prefix. No prerequisite source changes are needed:
int16x4_t already exists and hipconv already uses C++20.

The legacy BF16 MFMA builtins accept short vectors in both upstream LLVM
and ROCm LLVM. Preserve the BF16 bit patterns with the upstream explicit
conversions instead of changing the LLVM intrinsic ABI or numeric values.

diff --git a/src/hipconv/src/arch/cdna4/grouped/mfma_dispatch.h b/src/hipconv/src/arch/cdna4/grouped/mfma_dispatch.h
--- a/src/hipconv/src/arch/cdna4/grouped/mfma_dispatch.h
+++ b/src/hipconv/src/arch/cdna4/grouped/mfma_dispatch.h
@@ -3,6 +3,8 @@
 #include "packed_ops.h"
 #include "types.h"
 
+#include <bit>
+
 namespace hipconv::cdna4
 {
 
@@ -21,7 +23,8 @@ __device__ inline fp32x4_t mfma_16x16x16(fp16x4_t a, fp16x4_t b, fp32x4_t c)
 }
 __device__ inline fp32x4_t mfma_16x16x16(bf16x4_t a, bf16x4_t b, fp32x4_t c)
 {
-    return __builtin_amdgcn_mfma_f32_16x16x16bf16_1k(a, b, c, 0, 0, 0);
+    return __builtin_amdgcn_mfma_f32_16x16x16bf16_1k(
+        std::bit_cast<int16x4_t>(a), std::bit_cast<int16x4_t>(b), c, 0, 0, 0);
 }
 
 __device__ inline fp32x4_t mfma_4x4x4_16b(fp16x4_t a, fp16x4_t b, fp32x4_t c)
@@ -30,7 +33,8 @@ __device__ inline fp32x4_t mfma_4x4x4_16b(fp16x4_t a, fp16x4_t b, fp32x4_t c)
 }
 __device__ inline fp32x4_t mfma_4x4x4_16b(bf16x4_t a, bf16x4_t b, fp32x4_t c)
 {
-    return __builtin_amdgcn_mfma_f32_4x4x4bf16_1k(a, b, c, 0, 0, 0);
+    return __builtin_amdgcn_mfma_f32_4x4x4bf16_1k(
+        std::bit_cast<int16x4_t>(a), std::bit_cast<int16x4_t>(b), c, 0, 0, 0);
 }
 
 // TF32 (simulated): inputs are fp32, computed via 3x BF16 MFMA.
