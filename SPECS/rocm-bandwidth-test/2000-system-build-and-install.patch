--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -244,6 +244,13 @@
 endif()
 
 #
+# Standard distribution install; RPM owns dependencies and file placement.
+set_target_properties(${AMD_TARGET_LIBNAME} PROPERTIES SOVERSION ${AMD_TARGET_VERSION})
+install(TARGETS awb_main RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
+install(TARGETS ${AMD_TARGET_LIBNAME} LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR})
+install(TARGETS builtin transferbench LIBRARY DESTINATION ${PLUGIN_INSTALL_PATH})
+return()
+
 # Setup the package environment for custom install
 setup_distribution_package()
 
