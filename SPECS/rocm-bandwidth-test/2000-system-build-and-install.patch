+set_target_properties(amd_tb_lib PROPERTIES IMPORTED_LOCATION "${CMAKE_CURRENT_BINARY_DIR}/transferbench/libamd_tb.so")
 
 ##
 # Add the plugin
@@ -166,3 +158,7 @@
