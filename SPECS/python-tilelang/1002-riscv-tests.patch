+    out = kernel(data)
+
+    source = kernel.get_kernel_source()
+    kernel.close()
+
+    assert "func.func @reduce_max_rows" in source
+    assert "linalg.reduce" in source
+    assert "arith.select" in source
+    torch.testing.assert_close(out, torch.max(data, dim=1).values)
