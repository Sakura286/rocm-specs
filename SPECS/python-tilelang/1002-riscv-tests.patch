+def vec4_cast(A: T.Buffer((4,), "int32x4"), B: T.Buffer((4,), "float32x4")):
+    for i in T.serial(4):
+        B[i] = T.cast(A[i], "float32x4")
+""",
+        expected=(
+            "func.func @vec4_cast",
+            "memref<4xvector<4xi32>>",
+            "arith.sitofp",
+            ": vector<4xi32> to vector<4xf32>",
