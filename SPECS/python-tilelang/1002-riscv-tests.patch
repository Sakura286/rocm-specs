+        with T.block("sum"):
+            vi = T.axis.spatial(2, i)
+            vj = T.axis.reduce(3, j)
+            vk = T.axis.reduce(4, k)
+            with T.init():
+                B[vi] = T.float32(0)
+            B[vi] = B[vi] + A[vi, vj, vk]
