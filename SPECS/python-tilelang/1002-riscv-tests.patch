+@T.prim_func
+def unbound_dynamic_strided_local_alloc_probe(
+    A: T.Buffer((8,), "float32"),
+    B: T.Buffer((8,), "float32"),
+):
+    Tbuf = T.alloc_buffer((4,), "float32", strides=(s,))
