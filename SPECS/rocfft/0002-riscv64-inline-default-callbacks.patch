diff --git a/library/src/CMakeLists.txt b/library/src/CMakeLists.txt
index 3fc1bd5..0d8e9bc 100644
--- a/library/src/CMakeLists.txt
+++ b/library/src/CMakeLists.txt
@@ -20,6 +20,16 @@
 # THE SOFTWARE.
 # #############################################################################
 
+# Without relocatable device code the default callback function pointers must
+# be inlined into the RTC kernels instead of being resolved from device
+# symbols.  This keeps the library linkable on targets whose toolchain cannot
+# emit RDC host registration objects with the right ABI.
+option( ROCFFT_INLINE_DEFAULT_CALLBACKS
+        "Inline default callbacks in RTC kernels instead of using RDC" OFF )
+if( ROCFFT_INLINE_DEFAULT_CALLBACKS )
+  add_compile_definitions( ROCFFT_INLINE_DEFAULT_CALLBACKS )
+endif()
+
 # ########################################################################
 # A helper function to prefix a source list of files with a common path into a new list (non-destructive)
 # ########################################################################
@@ -422,8 +432,13 @@ endif()
 # need to be built as relocatable device code (causes failure at link
 # stage on Windows)
 if( NOT WIN32 AND NOT BUILD_CODE_COVERAGE )
-  target_compile_options( rocfft PRIVATE -fgpu-rdc )
-  target_link_options( rocfft PRIVATE -fgpu-rdc )
+  if( ROCFFT_INLINE_DEFAULT_CALLBACKS )
+    # The inlined default callbacks make the host library free of device
+    # symbols, so it does not need relocatable device code.
+  else()
+    target_compile_options( rocfft PRIVATE -fgpu-rdc )
+    target_link_options( rocfft PRIVATE -fgpu-rdc )
+  endif()
 endif()
 
 if( ROCFFT_MPI_ENABLE )
