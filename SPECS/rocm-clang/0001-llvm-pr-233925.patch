From: LLVM upstream PR #233925
Subject: [CUDA] Fix diagnosing of static variable initializers in device functions

Source: https://github.com/llvm/llvm-project/pull/233925
Commit: 6b8c5dd883ca6fc2a29e39d35b72fbadeb4a4a26
Status: upstream pull request, not merged when backported (2026-11-14).
Backport: no semantic changes; apply to openRuyi snapshot b1de84ea.

diff --git a/clang/lib/Sema/SemaCUDA.cpp b/clang/lib/Sema/SemaCUDA.cpp
--- a/clang/lib/Sema/SemaCUDA.cpp
+++ b/clang/lib/Sema/SemaCUDA.cpp
@@ -766,6 +766,7 @@ void SemaCUDA::checkAllowedInitializer(VarDecl *VD) {
       IsDependentVar(VD))
     return;
   const Expr *Init = VD->getInit();
+  SemaCUDA::CUDAVariableTarget VarTarget = IdentifyTarget(VD);
   if (IsDeviceOrConstantVar || IsSharedVar) {
     if (HasAllowedCUDADeviceStaticInitializer(
             *this, VD, IsSharedVar ? CICK_Shared : CICK_DeviceOrConstant))
@@ -774,7 +775,8 @@ void SemaCUDA::checkAllowedInitializer(VarDecl *VD) {
          IsSharedVar ? diag::err_shared_var_init : diag::err_dynamic_var_init)
         << Init->getSourceRange();
     VD->setInvalidDecl();
-  } else {
+  } else if (VarTarget == CVT_Host ||
+             (!getLangOpts().CUDAIsDevice && VarTarget == CVT_Both)) {
     // This is a host-side global variable.  Check that the initializer is
     // callable from the host side.
 
diff --git a/clang/test/SemaCUDA/global-initializers.cu b/clang/test/SemaCUDA/global-initializers.cu
--- a/clang/test/SemaCUDA/global-initializers.cu
+++ b/clang/test/SemaCUDA/global-initializers.cu
@@ -135,4 +135,44 @@ namespace ns2 {
   unsigned twotimes1 = ns1::value_func() + ns1::value_func();
   // expected-error@-1 {{reference to __device__ function 'value_func' in global initializer}}
 
+  __device__ constexpr int devicefoo() { return 1; }
+  // host-note@-1 6{{declared here}}
+
+  __device__ void static test_statics_in_device() {
+    static constexpr int b = devicefoo();
+    static int b1 = devicefoo();
+    [](){ // lambdas are automatically HD
+      static int b2 = devicefoo();
+      // host-error@-1 {{reference to __device__ function 'devicefoo' in global initializer}}
+      static constexpr int b3 = devicefoo();
+      // host-error@-1 {{reference to __device__ function 'devicefoo' in global initializer}}
+    }();
+  }
+  __host__ __device__ void static test_statics_in_hd() {
+    static constexpr int b = devicefoo();
+      // host-error@-1 {{reference to __device__ function 'devicefoo' in global initializer}}
+    static int b1 = devicefoo();
+      // host-error@-1 {{reference to __device__ function 'devicefoo' in global initializer}}
+    [](){
+      static int b2 = devicefoo();
+      // host-error@-1 {{reference to __device__ function 'devicefoo' in global initializer}}
+      static constexpr int b3 = devicefoo();
+      // host-error@-1 {{reference to __device__ function 'devicefoo' in global initializer}}
+    }();
+  }
+
+  template <typename T> __device__ void templatedevice() {
+    static constexpr T b = devicefoo();
+  }
+  template <>
+  __device__ void templatedevice<int>();
+  template <typename T> __device__ __host__ void templatehd() {
+    static constexpr T b = devicefoo();
+  }
+  // FIXME: probably should be diagnosed for host
+  template <>
+  __device__ __host__ void templatehd<int>();
+
+
+
 }
