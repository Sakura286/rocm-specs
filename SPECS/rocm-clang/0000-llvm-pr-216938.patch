From: LLVM upstream PR #216938
Subject: [LinkerWrapper] Use a four component triple for the host bundle entry

Source: https://github.com/llvm/llvm-project/pull/216938
Commit: 607dab5767199b4eef74b2b718a73e778e783f17
Status: upstream pull request, not merged when backported (2026-11-14).
Backport: no semantic changes; apply to openRuyi snapshot b1de84ea.

diff --git a/clang/test/OffloadTools/clang-linker-wrapper/linker-wrapper-hip-host-triple.c b/clang/test/OffloadTools/clang-linker-wrapper/linker-wrapper-hip-host-triple.c
new file mode 100644
--- /dev/null
+++ b/clang/test/OffloadTools/clang-linker-wrapper/linker-wrapper-hip-host-triple.c
@@ -0,0 +1,8 @@
+// The host bundle entry must be a four component triple.
+
+// RUN: llvm-offload-binary -o %t.out \
+// RUN:   --image=file=%s,kind=hip,triple=amdgpu9.0a-amd-amdhsa,arch=gfx90a
+// RUN: clang-linker-wrapper --dry-run --host-triple=x86_64-apple-macosx15.0.0 \
+// RUN:   --emit-fatbin-only %t.out -o %t.hipfb 2>&1 | FileCheck %s
+
+// CHECK: clang-offload-bundler{{.*}} -targets=host-x86_64-apple-macosx15.0.0-unknown,hip-amdgcn-amd-amdhsa--gfx90a
diff --git a/clang/tools/clang-linker-wrapper/ClangLinkerWrapper.cpp b/clang/tools/clang-linker-wrapper/ClangLinkerWrapper.cpp
--- a/clang/tools/clang-linker-wrapper/ClangLinkerWrapper.cpp
+++ b/clang/tools/clang-linker-wrapper/ClangLinkerWrapper.cpp
@@ -451,7 +451,8 @@ fatbinary(ArrayRef<std::tuple<StringRef, StringRef, StringRef>> InputFiles,
   llvm::Triple HostTriple(
       Args.getLastArgValue(OPT_host_triple_EQ, sys::getDefaultTargetTriple()));
   SmallVector<StringRef> Targets = {
-      Saver.save("-targets=host-" + HostTriple.normalize())};
+      Saver.save("-targets=host-" +
+                 HostTriple.normalize(Triple::CanonicalForm::FOUR_IDENT))};
   for (const auto &[File, TripleRef, Arch] : InputFiles) {
     std::string NormalizedTriple =
         clang::normalizeForBundler(Triple(TripleRef), Arch);
