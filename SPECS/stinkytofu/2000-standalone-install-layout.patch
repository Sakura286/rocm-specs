From: CHEN Xuan <chenxuan@iscas.ac.cn>
Subject: [PATCH] Support standalone distribution builds and installed rocISA glue

Use GNUInstallDirs, avoid monorepo-only compiler defaults, and export the
conversion sources required by a separately packaged hipBLASLt.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -3,12 +3,10 @@
 
 cmake_minimum_required(VERSION 3.16)
 
-if(CMAKE_SOURCE_DIR STREQUAL CMAKE_CURRENT_SOURCE_DIR)
-    include(${CMAKE_CURRENT_LIST_DIR}/../../cmake/modules/default_amdclang.cmake)
-endif()
 
 set(STINKYTOFU_VERSION "0.1.0")
 project(stinkytofu VERSION ${STINKYTOFU_VERSION} LANGUAGES CXX)
+include(GNUInstallDirs)
 
 set(STINKYTOFU_VERSION_MAJOR ${PROJECT_VERSION_MAJOR})
 set(STINKYTOFU_VERSION_MINOR ${PROJECT_VERSION_MINOR})
@@ -319,21 +317,21 @@
 
 install(TARGETS stinkytofu stinkytofu-warnings
     EXPORT stinkytofu-targets
-    LIBRARY DESTINATION lib
-    ARCHIVE DESTINATION lib
+    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
     RUNTIME DESTINATION bin
 )
 install(EXPORT stinkytofu-targets
     FILE stinkytofu-targets.cmake
     NAMESPACE stinkytofu::
-    DESTINATION lib/cmake/stinkytofu
+    DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/stinkytofu
 )
 
 include(CMakePackageConfigHelpers)
 configure_package_config_file(
     cmake/stinkytofuConfig.cmake.in
     ${CMAKE_CURRENT_BINARY_DIR}/stinkytofuConfig.cmake
-    INSTALL_DESTINATION lib/cmake/stinkytofu
+    INSTALL_DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/stinkytofu
 )
 write_basic_package_version_file(
     ${CMAKE_CURRENT_BINARY_DIR}/stinkytofuConfigVersion.cmake
@@ -343,7 +341,7 @@
 install(FILES
     ${CMAKE_CURRENT_BINARY_DIR}/stinkytofuConfig.cmake
     ${CMAKE_CURRENT_BINARY_DIR}/stinkytofuConfigVersion.cmake
-    DESTINATION lib/cmake/stinkytofu
+    DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/stinkytofu
 )
 
 # --------------------------------------------------------------------------- #
@@ -351,8 +349,10 @@
 # --------------------------------------------------------------------------- #
 option(ENABLE_CLANG_TIDY "Enable clang-tidy targets" OFF)
 list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_SOURCE_DIR}/../../cmake/modules")
-include(ClangTidy)
-add_clang_tidy_custom_target()
+if(ENABLE_CLANG_TIDY)
+    include(ClangTidy)
+    add_clang_tidy_custom_target()
+endif()
 
 # Build-tree export so find_package() works without installing.
 # Write targets to stinkytofu-targets.cmake (not stinkytofuConfig.cmake) to
@@ -410,3 +410,8 @@
     ${TABLEGEN_OUTPUT_DIR}/PythonBindings_generated.inc
     DESTINATION include/stinkytofu/bindings/python
 )
+
+# rocISA compiles these conversion bindings against its own headers.
+install(DIRECTORY src/conversion/rocisa/
+    DESTINATION ${CMAKE_INSTALL_DATADIR}/stinkytofu/rocisa
+    FILES_MATCHING PATTERN "*.cpp" PATTERN "*.hpp")
--- a/tools/intrinsic-compiler/CMakeLists.txt
+++ b/tools/intrinsic-compiler/CMakeLists.txt
@@ -50,7 +50,7 @@
 
 # Install the .st.bc file
 install(FILES "${INTRINSIC_BC_FILE}"
-        DESTINATION lib
+        DESTINATION ${CMAKE_INSTALL_LIBDIR}/stinkytofu
         COMPONENT runtime)
 
 ##===----------------------------------------------------------------------===##
--- a/cmake/stinkytofuConfig.cmake.in
+++ b/cmake/stinkytofuConfig.cmake.in
@@ -3,3 +3,5 @@
 
 @PACKAGE_INIT@
 include("${CMAKE_CURRENT_LIST_DIR}/stinkytofu-targets.cmake")
+
+set(stinkytofu_ROCISA_SOURCE_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/stinkytofu/rocisa")
