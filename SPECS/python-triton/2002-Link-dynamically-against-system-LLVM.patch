From 331a33515864ac18d627bf3a5d009366c67ed61f Mon Sep 17 00:00:00 2001
From: CHEN Xuan <chenxuan@iscas.ac.cn>
Date: Sun, 12 Jul 2026 01:05:27 +0800
Subject: [PATCH 3/4] Link dynamically against system LLVM

Based on home:nekorouter/triton-llvm22 and openRuyi PR #861.
---
 CMakeLists.txt       | 27 +--------------------------
 cmake/FindLLVM.cmake |  4 ++--
 2 files changed, 3 insertions(+), 28 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index eab45c1..cdca173 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -256,37 +256,12 @@ if(TRITON_BUILD_PYTHON_MODULE)
     MLIRPluginsLib
 
     # LLVM
-    LLVMPasses
-    LLVMNVPTXCodeGen
-    # LLVMNVPTXAsmPrinter
-    LLVMAMDGPUCodeGen
-    LLVMAMDGPUAsmParser
+    LLVM
 
     Python3::Module
     pybind11::headers
 
   )
-  if(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64" OR # Linux arm64
-     CMAKE_SYSTEM_PROCESSOR MATCHES "arm64" OR # macOS arm64
-     CMAKE_OSX_ARCHITECTURES MATCHES "arm64")  # also macOS arm64
-      list(APPEND TRITON_LIBRARIES
-          LLVMAArch64CodeGen
-          LLVMAArch64AsmParser
-      )
-  elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64" OR CMAKE_SYSTEM_PROCESSOR MATCHES "AMD64")
-      list(APPEND TRITON_LIBRARIES
-          LLVMX86CodeGen
-          LLVMX86AsmParser
-      )
-  elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "ppc64le")
-      list(APPEND TRITON_LIBRARIES
-        LLVMPowerPCAsmParser
-        LLVMPowerPCCodeGen
-      )
-  else()
-    message(FATAL_ERROR "LLVM codegen/ASM parser libs: This HW architecture (${CMAKE_SYSTEM_PROCESSOR}) is not configured in cmake lib dependencies.")
-  endif()
-
   # Define triton library
   string(JOIN "," TRITON_BACKENDS_TUPLE ${TRITON_CODEGEN_BACKENDS})
 
diff --git a/cmake/FindLLVM.cmake b/cmake/FindLLVM.cmake
index 47d068f..3b09cfd 100644
--- a/cmake/FindLLVM.cmake
+++ b/cmake/FindLLVM.cmake
@@ -80,7 +80,7 @@ else()
         endif()
         set(result_code)
         execute_process(
-            COMMAND ${LLVM_CONFIG} --link-static --${flag}
+            COMMAND ${LLVM_CONFIG} --link-shared --${flag}
             RESULT_VARIABLE result_code
             OUTPUT_VARIABLE LLVM_${var}
             OUTPUT_STRIP_TRAILING_WHITESPACE
@@ -100,7 +100,7 @@ else()
         endif()
         set(result_code)
         execute_process(
-            COMMAND ${LLVM_CONFIG} --link-static --${flag} ${components}
+            COMMAND ${LLVM_CONFIG} --link-shared --${flag} ${components}
             RESULT_VARIABLE result_code
             OUTPUT_VARIABLE tmplibs
             OUTPUT_STRIP_TRAILING_WHITESPACE
-- 
2.53.0

