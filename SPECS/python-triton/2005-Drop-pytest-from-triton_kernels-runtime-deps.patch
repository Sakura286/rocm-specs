Drop pytest from triton_kernels runtime dependencies

pytest is only used by the bundled test suite, which the
python-triton-kernels subpackage does not ship.  Listing it as a
runtime dependency would drag pytest into every consumer (e.g. vLLM)
through the automatic python3dist Requires generator.

Generated with diff -Naur against the triton v3.7.1 tag tree.

--- a/python/triton_kernels/pyproject.toml	2026-07-21 11:59:43.344972882 +0800
+++ b/python/triton_kernels/pyproject.toml	2026-07-21 11:59:43.345965905 +0800
@@ -1,7 +1,7 @@
 [project]
 name = "triton_kernels"
 version = "1.0.0"
-dependencies = ["numpy", "pytest"]
+dependencies = ["numpy"]
 
 [project.optional-dependencies]
 tests = ["llnl-hatchet", "matplotlib", "pandas"]
