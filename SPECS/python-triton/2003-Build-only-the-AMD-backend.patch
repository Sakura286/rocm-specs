From 5713335cb101e276f0f57e68256622bcb915b9fe Mon Sep 17 00:00:00 2001
From: CHEN Xuan <chenxuan@iscas.ac.cn>
Date: Sun, 12 Jul 2026 01:05:37 +0800
Subject: [PATCH 4/4] Build only the AMD backend

Based on home:nekorouter/triton-llvm22 and openRuyi PR #861.
---
 CMakeLists.txt                                | 42 +++++++++++++------
 MANIFEST.in                                   |  3 ++
 lib/Conversion/CMakeLists.txt                 |  4 +-
 python/triton/experimental/gluon/__init__.py  |  3 +-
 .../experimental/gluon/language/__init__.py   |  1 -
 setup.py                                      | 22 ++++++++--
 third_party/nvidia/CMakeLists.txt             |  4 +-
 third_party/nvidia/hopper/CMakeLists.txt      |  4 +-
 third_party/nvidia/include/CMakeLists.txt     |  6 ++-
 third_party/nvidia/lib/CMakeLists.txt         |  6 ++-
 third_party/proton/Dialect/CMakeLists.txt     |  2 +-
 .../Conversion/ProtonGPUToLLVM/CMakeLists.txt |  4 +-
 .../lib/ProtonGPUToLLVM/CMakeLists.txt        |  4 +-
 13 files changed, 75 insertions(+), 30 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index cdca173..8e85d43 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -20,11 +20,19 @@ option(TRITON_BUILD_PYTHON_MODULE "Build Python Triton bindings" OFF)
 option(TRITON_BUILD_PROTON "Build the Triton Proton profiler" ON)
 option(TRITON_BUILD_UT "Build C++ Triton Unit Tests" ON)
 option(TRITON_BUILD_WITH_CCACHE "Build with ccache (if available)" ON)
+option(TRITON_BUILD_EXAMPLES "Build Triton examples and sample plugins" ON)
+option(TRITON_BUILD_TOOLS "Build Triton command-line tools and tests" ON)
 option(TRITON_OFFLINE_BUILD "Build without downloading dependencies" OFF)
 option(TRITON_EXT_ENABLED "Build with default visibility for Triton+LLVM symbol exposure to plugin extensions" OFF)
 set(TRITON_CODEGEN_BACKENDS "" CACHE STRING "Enable different codegen backends")
 set(TRITON_VERSION "" CACHE STRING "Triton version string (passed from setup.py)")
 
+list(FIND TRITON_CODEGEN_BACKENDS "nvidia" TRITON_NVIDIA_BACKEND_INDEX)
+set(TRITON_BUILD_NVIDIA_BACKEND_PLUGIN OFF)
+if(NOT TRITON_NVIDIA_BACKEND_INDEX EQUAL -1)
+  set(TRITON_BUILD_NVIDIA_BACKEND_PLUGIN ON)
+endif()
+
 if(TRITON_BUILD_WITH_CCACHE)
   find_program(CCACHE_PROGRAM ccache)
   if(CCACHE_PROGRAM)
@@ -201,11 +209,15 @@ if(TRITON_BUILD_PYTHON_MODULE)
     add_subdirectory(third_party/${CODEGEN_BACKEND})
   endforeach()
 
+  if(NOT TRITON_BUILD_NVIDIA_BACKEND_PLUGIN)
+    add_subdirectory(third_party/nvidia)
+  endif()
+
   if (TRITON_BUILD_PROTON)
     add_subdirectory(third_party/proton)
+    list(APPEND TRITON_PLUGIN_NAMES "proton")
   endif()
   # We always build proton dialect
-  list(APPEND TRITON_PLUGIN_NAMES "proton")
   add_subdirectory(third_party/proton/Dialect)
 
   if (DEFINED TRITON_PLUGIN_DIRS)
@@ -314,7 +326,9 @@ if(TRITON_BUILD_PYTHON_MODULE)
     COPYONLY)
 
   # Build plugins when building libtriton since they depend on libtriton.
-  add_subdirectory(examples/plugins)
+  if(TRITON_BUILD_EXAMPLES)
+    add_subdirectory(examples/plugins)
+  endif()
 endif()
 
 if (UNIX AND NOT APPLE AND NOT TRITON_EXT_ENABLED)
@@ -342,15 +356,17 @@ endif()
 find_package(Threads REQUIRED)
 
 add_subdirectory(third_party/f2reduce)
-add_subdirectory(bin)
-add_subdirectory(test)
-
-if(TRITON_BUILD_UT)
-  add_subdirectory(unittest)
-  # This target runs all the unit tests.
-  add_custom_target(check-triton-unit-tests
-    COMMAND ${CMAKE_CTEST_COMMAND} --output-on-failure
-    DEPENDS TritonUnitTests
-    USES_TERMINAL
-  )
+if(TRITON_BUILD_TOOLS)
+  add_subdirectory(bin)
+  add_subdirectory(test)
+
+  if(TRITON_BUILD_UT)
+    add_subdirectory(unittest)
+    # This target runs all the unit tests.
+    add_custom_target(check-triton-unit-tests
+      COMMAND ${CMAKE_CTEST_COMMAND} --output-on-failure
+      DEPENDS TritonUnitTests
+      USES_TERMINAL
+    )
+  endif()
 endif()
diff --git a/MANIFEST.in b/MANIFEST.in
