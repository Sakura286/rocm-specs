diff --git a/setup.py b/setup.py
index 8bb6133..cc4ad5a 100644
--- a/setup.py
+++ b/setup.py
@@ -407,7 +407,8 @@ class CMakeBuild(build_ext):
         build_ext.finalize_options(self)
 
     def run(self):
-        download_and_copy_dependencies()
+        if any(backend.name == "nvidia" for backend in backends):
+            download_and_copy_dependencies()
 
         try:
             out = subprocess.check_output(["cmake", "--version"])
@@ -631,7 +632,12 @@ def download_and_copy_dependencies():
     )
 
 
-backends = [*BackendInstaller.copy(["nvidia", "amd"]), *BackendInstaller.copy_externals()]
+def get_enabled_in_tree_backends():
+    backends = os.getenv("TRITON_CODEGEN_BACKENDS")
+    return ["nvidia", "amd"] if backends is None else [backend for backend in backends.split(";") if backend]
+
+
+backends = [*BackendInstaller.copy(get_enabled_in_tree_backends()), *BackendInstaller.copy_externals()]
 
 
 def get_package_dirs():
@@ -662,7 +668,17 @@ def get_package_dirs():
 
 
 def get_packages():
-    yield from find_packages(where="python")
+    excludes = []
+    if not any(backend.name == "nvidia" for backend in backends):
+        excludes.extend([
+            "triton.experimental.gluon.nvidia",
+            "triton.experimental.gluon.nvidia.*",
+            "triton.experimental.gluon.language.nvidia",
+            "triton.experimental.gluon.language.nvidia.*",
+            "triton.tools.triton_to_gluon_translater",
+            "triton.tools.triton_to_gluon_translater.*",
+        ])
+    yield from find_packages(where="python", exclude=excludes)
 
     for backend in backends:
         yield f"triton.backends.{backend.name}"
