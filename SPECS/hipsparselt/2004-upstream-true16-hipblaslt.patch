From: CHEN Xuan <chenxuan@iscas.ac.cn>
Subject: [PATCH] Backport upstream true16 operand half selection

Upstream: https://github.com/ROCm/rocm-libraries/commit/bf56af2e53b7ba22b4ac86e8d8cd25df8040b0f2
Upstream-PR: https://github.com/ROCm/rocm-libraries/pull/10052 (merged)
Upstream-Commit: bf56af2e53b7ba22b4ac86e8d8cd25df8040b0f2

Carry the complete projects/hipblaslt subtree change; the companion subtree is carried
by the matching StinkyTofu/hipBLASLt packages. Only strip the monorepo path
prefix. No prerequisite source changes were needed on therock-10.1.

diff --git a/device-library/extops/CMakeLists.txt b/device-library/extops/CMakeLists.txt
index 27cba450c363..ec5b59ac684f 100644
--- a/device-library/extops/CMakeLists.txt
+++ b/device-library/extops/CMakeLists.txt
@@ -20,10 +20,16 @@ foreach(arch IN LISTS archs)
     if(arch MATCHES "^gfx1[12][0-9][0-9]$")
         set(WAVEFRONT "-mno-wavefrontsize64")
     endif()
+    # Enable true16 on all gfx11*/gfx12* (NoSDWA). "SHELL:" keeps the flag group
+    # intact so CMake de-duplication does not drop the paired +real-true16.
+    set(TRUE16_FEATURE "")
+    if(arch MATCHES "^gfx1[12][0-9][0-9]$")
+        set(TRUE16_FEATURE "SHELL:-Xclangas -target-feature -Xclangas +real-true16")
+    endif()
     add_library(extop-obj-${arch} OBJECT)
     target_compile_options(extop-obj-${arch}
         PRIVATE
-            -Wno-unused-command-line-argument -x assembler -target amdgcn-amd-amdhsa -mcode-object-version=4 -mcpu=${offload_arch} ${WAVEFRONT} -c
+            -Wno-unused-command-line-argument -x assembler -target amdgcn-amd-amdhsa -mcode-object-version=4 -mcpu=${offload_arch} ${WAVEFRONT} -c ${TRUE16_FEATURE}
     )
     target_sources(extop-obj-${arch}
         PRIVATE
