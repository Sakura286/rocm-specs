From: CHEN Xuan <chenxuan@iscas.ac.cn>
Subject: [PATCH] Find installed origami package

Refresh existing distribution path/dependency adaptation for therock-10.1.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -280,7 +280,7 @@
             set(ORIGAMI_ENABLE_PYTHON OFF)
             set(BUILD_TESTING OFF)
             set(CMAKE_VISIBILITY_INLINES_HIDDEN ON)
-            add_subdirectory("${CMAKE_CURRENT_SOURCE_DIR}/../../shared/origami" "${CMAKE_CURRENT_BINARY_DIR}/origami" EXCLUDE_FROM_ALL)
+            find_package(origami CONFIG REQUIRED)
         endblock()
     endif()
 endif()
